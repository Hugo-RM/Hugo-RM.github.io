<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head.ejs") %>
</head>

<body>
    <h1 class="bg-info text-white p-3 m-0"> The Solar System </h1>

    <%- include("partials/nav.ejs") %>

    <div class="container-fluid row">
        <div class="card p-4 col">
            <h2><%= planet %></h2>

            <%= planetInfo.description %>

            <h3>Distance From the Sun: <%= planetInfo.distanceFromSun %></h3>
            
            <h3>Year Length: <%= planetInfo.yearLength %></h3>

            <h3>Radius: <%= planetInfo.radius %></h3>
            
            <h3>Moons: <%= planetInfo.moons %> </h3>

            <h3>1 day is equivalent to <%= planetInfo.oneEarthDay %> </h3>
        </div>

        <div class="card col">
            <img src="<%= planetInfo.image %>" class="rounded">
        </div>
    </div>

    <%- include("partials/footer.ejs") %>

</body>

</html>